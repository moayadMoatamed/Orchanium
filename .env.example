# Meta Model API key (docs call it MODEL_API_KEY; either name works)
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
# Cheap model for high-volume low-stakes calls. Contributor mode = prompts may be used for training.
META_MODEL_CHEAP=muse-spark-1.3
SAM_MODEL=sam-3.1
# Contact URL sent in the citation checker's User-Agent (Wikipedia blocks bots without one), e.g. your repo URL
FETCH_CONTACT_URL=
